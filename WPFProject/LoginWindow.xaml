<Window x:Class="WPFProject.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFProject"
        mc:Ignorable="d"
        Title="LoginWindow" Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F4F6">
    <Grid>
        <Border Width="300" Height="250" Background="White" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
            <StackPanel>
                <TextBlock Text="Bejelentkezés" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                <TextBox x:Name="txtUsername" Height="35" Margin="0,5"/>
                <PasswordBox x:Name="txtPassword" Height="35" Margin="0,5"/>
                <Button Content="Login" Height="35" Margin="0,15,0,0" Background="#2563EB" Foreground="White" Click="btnLogin_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
